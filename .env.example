# Line Messaging API 設定
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 存取控管：允許使用 Line Bot 控制 Antigravity 的 Line User ID 列表 (以逗號分隔)
# 例如: U1234567890abcdef1234567890abcdef,U0987654321fedcba0987654321fedcba
ALLOWED_USER_IDS=U1234567890abcdef1234567890abcdef

# Google Gemini API Key (用於 Antigravity SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# 服務設定
HOST=0.0.0.0
PORT=8000
